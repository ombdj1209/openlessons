    {
      "eyebrow": "Three parts",
      "caption": "Most systems split into three: the client you hold, the server that thinks, the database that remembers.",
      "form": {
        "type": "spheres",
        "r": 92,
        "items": [
          {
            "at": [
              400,
              400
            ],
            "label": "CLIENT",
            "note": "The app or browser in someone's hand. It shows things and sends requests."
          },
          {
            "at": [
              800,
              400
            ],
            "label": "SERVER",
            "note": "Runs your code: checks who you are, applies the rules, decides what happens."
          },
          {
            "at": [
              1200,
              400
            ],
            "label": "DATABASE",
            "note": "Remembers everything, safely, even when servers restart."
          }
        ]
      },
      "chapter": "The parts"
    },
    {
      "eyebrow": "One job each",
      "caption": "Each part has one job. Keep them separate, and each can grow on its own.",
      "dur": 6.5,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "laptop",
            "at": [
              400,
              420
            ],
            "label": "CLIENT",
            "note": "Clients are untrusted: anything they send is checked by the server."
          },
          {
            "shape": "server",
            "at": [
              800,
              420
            ],
            "label": "SERVER",
            "note": "Servers are interchangeable copies, so you can run as many as traffic needs."
          },
          {
            "shape": "database",
            "at": [
              1200,
              420
            ],
            "label": "DATABASE",
            "note": "The one place that holds the truth. Everything else can be rebuilt from it."
          }
        ]
      }
    },
    {
      "eyebrow": "Quick check",
      "caption": "Quick one before we send a request.",
