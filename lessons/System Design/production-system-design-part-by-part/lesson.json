    {
      "eyebrow": "04 · Stateless services",
      "caption": "Each copy forgets everything between requests, so any copy can serve any user. When traffic grows, just *add more copies*.",
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "server",
            "at": [
              460,
              400
            ],
            "scale": 0.85,
            "label": "COPY 1"
          },
          {
            "shape": "server",
            "at": [
              800,
              400
            ],
            "scale": 0.85,
            "label": "COPY 2"
          },
          {
            "shape": "server",
            "at": [
              1140,
              400
            ],
            "scale": 0.85,
            "accent": true,
            "label": "+ AUTOSCALED",
            "note": "An autoscaler watches CPU and request rate, and starts a new copy within a minute when they climb."
          }
        ]
      }
    },
    {
      "eyebrow": "Quick check",
      "caption": "Before we add a cache, test yourself.",
      "check": {
        "question": "Why can any copy of the API serve any user?",
        "options": [
          "The copies share memory",
          "Each copy keeps no state between requests",
          "The load balancer remembers users"
        ],
        "answer": 1,
        "explain": "Because they're *stateless*. Sessions live in a cache or a token, so every copy is interchangeable and safe to add or remove."
      }
    },
    {
      "eyebrow": "05 · Caching",
      "caption": "Some data is asked for constantly. Keep it in a *cache*, a fast memory store that answers in about 1 ms instead of 50.",
