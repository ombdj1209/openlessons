    {
      "eyebrow": "Quick check",
      "caption": "Replication has one catch.",
      "check": {
        "question": "A user just saved their profile. Where should the next read come from?",
        "options": [
          "A replica",
          "The primary",
          "The CDN"
        ],
        "answer": 1,
        "explain": "Replicas run a few milliseconds behind, so a replica might still show the old profile. *Read your own writes from the primary.*"
      }
    },
