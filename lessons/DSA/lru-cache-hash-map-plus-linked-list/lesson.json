      ],
      "problem": {
        "statement": "Design a data structure that follows the constraints of a *Least Recently Used* (LRU) cache. get(key) returns the value, or −1 if the key is absent. put(key, value) inserts or updates the key; if the number of keys exceeds the capacity, evict the least recently used key.",
        "example": [
          "LRUCache(2); put(1, 1); put(2, 2); get(1) → 1",
          "put(3, 3) evicts key 2; get(2) → −1",
          "put(4, 4) evicts key 1; get(1) → −1; get(3) → 3; get(4) → 4"
        ],
        "constraints": [
          "1 <= capacity <= 3000",
          "0 <= key <= 10^4",
          "At most 2 * 10^5 calls to get and put"
        ],
        "followUp": "get and put must each run in O(1) average time."
      }
    },
    {
      "eyebrow": "In plain English",
      "chapter": "Problem",
      "panel": false,
      "dur": 9,
      "caption": "What the interviewer is really asking.",
      "plain": {
        "asking": "Build a small memory with a fixed number of slots. When it is full, *throw out whatever was used longest ago*.",
        "points": [
          "*You get:* a stream of get and put calls.",
          "*You return:* the stored value, or −1 if it was thrown out.",
          "*The catch:* every call must be O(1), instant."
        ]
      }
    },
    {
      "eyebrow": "One tool isn't enough",
      "dur": 10,
      "caption": "A *hash map* finds a key instantly but can't tell which key is oldest. A *list* keeps the order but is slow to search. We need both.",
