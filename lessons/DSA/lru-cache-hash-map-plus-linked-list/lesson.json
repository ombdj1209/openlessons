      "labels": [
        {
          "text": "from collections import OrderedDict   # hash map + linked list",
          "at": [
            370,
            204
          ],
          "code": true
        },
        {
          "text": "class LRUCache:",
          "at": [
            370,
            240
          ],
          "code": true
        },
        {
          "text": "    def __init__(self, capacity):",
          "at": [
            370,
            276
          ],
          "code": true
        },
        {
          "text": "        self.cap, self.d = capacity, OrderedDict()",
          "at": [
            370,
            312
          ],
          "code": true
        },
        {
          "text": "    def get(self, key):",
          "at": [
            370,
            348
          ],
          "code": true
        },
        {
          "text": "        if key not in self.d: return -1",
          "at": [
            370,
            384
          ],
          "code": true
        },
        {
          "text": "        self.d.move_to_end(key)             # now the most recent",
          "at": [
            370,
            420
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        return self.d[key]",
          "at": [
            370,
            456
          ],
          "code": true
        },
        {
          "text": "    def put(self, key, value):",
          "at": [
            370,
            492
          ],
          "code": true
        },
        {
          "text": "        self.d[key] = value",
          "at": [
            370,
            528
          ],
          "code": true
        },
        {
          "text": "        self.d.move_to_end(key)",
          "at": [
            370,
            564
          ],
          "code": true
        },
        {
          "text": "        if len(self.d) > self.cap:",
          "at": [
            370,
            600
          ],
          "code": true
        },
        {
          "text": "            self.d.popitem(last=False)      # drop the least recent",
          "at": [
            370,
            636
          ],
          "code": true,
          "accent": true
        }
      ]
