      "problem": {
        "statement": "Given an integer array *nums*, return all the triplets [nums[i], nums[j], nums[k]] such that i, j and k are different and nums[i] + nums[j] + nums[k] == 0. The answer must not contain duplicate triplets.",
        "example": [
          "Input:  nums = [-1, 0, 1, 2, -1, -4]",
          "Output: [[-1, -1, 2], [-1, 0, 1]]",
          "The order of the output and of each triplet does not matter"
        ],
        "constraints": [
          "3 <= nums.length <= 3000",
          "-10^5 <= nums[i] <= 10^5"
        ]
      }
    },
