    {
      "eyebrow": "The code",
      "chapter": "Code",
      "caption": "Here is the whole solution: one sort, then one squeeze per fixed number. O(n²) in total.",
      "dur": 10,
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "box",
            "at": [
              800,
              420
            ],
            "w": 920,
            "h": 594
          }
        ]
      },
      "labels": [
        {
          "text": "def three_sum(nums):",
          "at": [
            370,
            168
          ],
          "code": true
        },
        {
          "text": "    nums.sort()",
          "at": [
            370,
            204
          ],
          "code": true
        },
        {
          "text": "    res = []",
          "at": [
            370,
            240
          ],
          "code": true
        },
        {
          "text": "    for i in range(len(nums) - 2):",
          "at": [
            370,
            276
          ],
          "code": true
        },
        {
          "text": "        if i and nums[i] == nums[i - 1]: continue   # same start",
          "at": [
            370,
            312
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        l, r = i + 1, len(nums) - 1",
          "at": [
            370,
            348
          ],
          "code": true
        },
        {
          "text": "        while l < r:",
          "at": [
            370,
            384
          ],
          "code": true
        },
        {
          "text": "            s = nums[i] + nums[l] + nums[r]",
          "at": [
            370,
            420
          ],
          "code": true
        },
        {
          "text": "            if s < 0: l += 1               # too small",
          "at": [
            370,
            456
          ],
          "code": true
        },
        {
          "text": "            elif s > 0: r -= 1             # too big",
          "at": [
            370,
            492
          ],
          "code": true
        },
        {
          "text": "            else:",
          "at": [
            370,
            528
          ],
          "code": true
        },
        {
          "text": "                res.append([nums[i], nums[l], nums[r]])",
          "at": [
            370,
            564
          ],
          "code": true
        },
        {
          "text": "                l += 1",
          "at": [
            370,
            600
          ],
          "code": true
        },
        {
          "text": "                while l < r and nums[l] == nums[l - 1]: l += 1",
          "at": [
            370,
            636
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "    return res",
          "at": [
            370,
            672
          ],
          "code": true
        }
      ]
    },
