      ],
      "problem": {
        "statement": "Given an integer array *nums* and an integer *k*, return the k most frequent elements. You may return the answer in any order.",
        "example": [
          "Input:  nums = [1, 1, 1, 2, 2, 3], k = 2",
          "Output: [1, 2]"
        ],
        "constraints": [
          "1 <= nums.length <= 10^5",
          "-10^4 <= nums[i] <= 10^4",
          "k is in the range [1, number of unique elements]",
          "The answer is guaranteed to be unique"
        ],
        "followUp": "Your algorithm's time complexity must be better than O(n log n), where n is the array's size."
      }
    },
    {
      "eyebrow": "In plain English",
      "chapter": "Problem",
      "panel": false,
      "dur": 9,
      "caption": "What the interviewer is really asking.",
      "plain": {
        "asking": "Find the *k numbers that show up most often*.",
        "points": [
          "*You get:* a list and a number k, like k = 2.",
          "*You return:* the k most common numbers, like [1, 2].",
          "*The catch:* it must beat sorting, so better than O(n log n)."
        ]
      }
    },
    {
      "eyebrow": "The example",
      "dur": 7,
      "caption": "Here's the list. 1 shows up three times, 2 twice, 3 once. With k = 2 the answer is *1 and 2*.",
