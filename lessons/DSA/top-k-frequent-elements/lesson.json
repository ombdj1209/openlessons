    },
    {
      "eyebrow": "Quick check",
      "caption": "Your turn.",
      "check": {
        "question": "Why can the bucket list stop at n + 1 slots?",
        "options": [
          "No number can appear more than n times",
          "k is never bigger than n",
          "Python lists have a size limit"
        ],
        "answer": 0,
        "explain": "In a list of n numbers, any value appears at most n times, so counts run from 1 to n. That bound is what makes *bucket sort* work here."
      }
    },
    {
      "eyebrow": "The code",
      "chapter": "Code",
      "caption": "Here is the whole solution: count, bucket, read from the top. O(n) time.",
      "dur": 10,
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "box",
            "at": [
              800,
              420
            ],
            "w": 920,
            "h": 486
          }
        ]
      },
      "labels": [
        {
          "text": "from collections import Counter",
          "at": [
            370,
            222
          ],
          "code": true
        },
        {
          "text": "def top_k_frequent(nums, k):",
          "at": [
            370,
            258
          ],
          "code": true
        },
        {
          "text": "    count = Counter(nums)                     # number -> count",
          "at": [
            370,
            294
          ],
          "code": true
        },
        {
          "text": "    buckets = [[] for _ in range(len(nums) + 1)]",
          "at": [
            370,
            330
          ],
          "code": true
        },
        {
          "text": "    for num, c in count.items():",
          "at": [
            370,
            366
          ],
          "code": true
        },
        {
          "text": "        buckets[c].append(num)                # index = how often",
          "at": [
            370,
            402
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "    out = []",
          "at": [
            370,
            438
          ],
          "code": true
        },
        {
          "text": "    for c in range(len(nums), 0, -1):         # most frequent first",
          "at": [
            370,
            474
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        for num in buckets[c]:",
          "at": [
            370,
            510
          ],
          "code": true
        },
        {
          "text": "            out.append(num)",
          "at": [
            370,
            546
          ],
          "code": true
        },
        {
          "text": "            if len(out) == k:",
          "at": [
            370,
            582
          ],
          "code": true
        },
        {
          "text": "                return out",
          "at": [
            370,
            618
          ],
          "code": true
        }
      ]
    },
