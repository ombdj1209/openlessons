        }
      ]
    },
    {
      "eyebrow": "Read from the top",
      "dur": 9,
      "caption": "Walk the buckets from the top. 6, 5 and 4 are empty. Bucket 3 gives 1, bucket 2 gives 2. That is k = 2 numbers: *[1, 2]*.",
      "form": {
        "type": "shapes",
