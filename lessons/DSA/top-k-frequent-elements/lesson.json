    },
    {
      "eyebrow": "The key idea",
      "dur": 10,
      "caption": "A count can never be more than n, the length of the list. So make *n + 1 buckets*, one per possible count, and drop each number into its bucket.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              800,
              440
            ],
            "scale": 0.9,
            "values": [
              "·",
              "3",
              "2",
              "1",
              "·",
              "·",
              "·"
            ],
            "note": "Bucket i holds the numbers that appear exactly i times."
          }
        ]
      },
      "labels": [
        {
          "text": "bucket index = how many times it appears",
          "at": [
            800,
            300
          ],
          "accent": true
        }
      ]
    },
    {
      "eyebrow": "Fill the buckets",
      "dur": 9,
      "caption": "1 appears 3 times, so it goes in bucket 3. 2 goes in bucket 2, and 3 in bucket 1. Nothing was sorted: each number was *placed directly*.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              800,
              440
            ],
            "scale": 0.9,
            "values": [
