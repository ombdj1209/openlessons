              "LETTER",
              "LAST SEEN"
            ],
            "hi": [
              1
            ],
            "note": "Where each letter was last seen. A repeat tells us exactly where the left edge must go."
          }
        ]
      },
      "labels": [
        {
          "text": "best stays 3 ✓",
          "at": [
            560,
            290
          ],
          "accent": true
        }
      ]
    },
    {
      "eyebrow": "Quick check",
      "caption": "Your turn.",
      "check": {
        "question": "In \"abba\" we reach the last a (index 3). Left is at 2. The map says a was last seen at 0. Where does left go?",
        "options": [
          "To 1",
          "It stays at 2",
          "To 4"
        ],
        "answer": 1,
        "explain": "That old a at 0 is already *outside* the window. Only jump when the old copy is at or after left. Left never moves backwards."
      }
    },
    {
      "eyebrow": "The code",
      "chapter": "Code",
      "caption": "Here is the whole solution. One pass, and each line matches a step we just walked through.",
      "dur": 10,
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "box",
            "at": [
              800,
              420
            ],
            "w": 920,
            "h": 378
          }
        ]
      },
      "labels": [
        {
          "text": "def length_of_longest_substring(s):",
          "at": [
            370,
            276
          ],
          "code": true
        },
        {
          "text": "    last = {}                      # letter -> where we last saw it",
          "at": [
            370,
            312
          ],
          "code": true
        },
        {
          "text": "    left = best = 0",
          "at": [
            370,
            348
          ],
          "code": true
        },
        {
          "text": "    for right, ch in enumerate(s):",
          "at": [
            370,
            384
          ],
          "code": true
        },
        {
          "text": "        if last.get(ch, -1) >= left:   # repeat inside the window",
          "at": [
            370,
            420
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "            left = last[ch] + 1        # jump past the old copy",
          "at": [
            370,
            456
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        last[ch] = right",
          "at": [
            370,
            492
          ],
          "code": true
        },
        {
          "text": "        best = max(best, right - left + 1)",
          "at": [
            370,
            528
          ],
          "code": true
        },
        {
          "text": "    return best",
          "at": [
            370,
            564
          ],
          "code": true
        }
      ]
    },
    {
      "eyebrow": "If the rules change",
      "chapter": "Other ways",
      "caption": "A window plus a last-seen map wins here. Change one rule and another version is the better pick:",
      "dur": 11,
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "box",
            "at": [
              300,
              420
            ],
            "w": 400,
            "h": 170,
            "text": "128-slot array",
            "id": "alt0"
          },
          {
            "shape": "box",
            "at": [
              800,
              420
            ],
            "w": 400,
            "h": 170,
            "text": "Window + counts",
            "id": "alt1"
          },
          {
            "shape": "box",
            "at": [
              1300,
              420
            ],
            "w": 400,
            "h": 170,
            "text": "Bitmask window",
            "id": "alt2"
          }
        ]
      },
      "labels": [
        {
          "text": "IF THE TEXT IS PLAIN ASCII",
          "at": [
            300,
            300
          ],
          "accent": true
        },
        {
          "text": "no hashing · fixed 128 ints of memory",
          "at": [
