  "steps": [
    {
      "eyebrow": "The problem",
      "chapter": "Problem",
      "panel": false,
      "dur": 12,
      "caption": "The interviewer reads you the problem.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "text",
            "at": [
              800,
              168
            ],
            "text": "LONGEST UNIQUE SUBSTRING",
            "size": 72
          }
        ]
      },
      "labels": [
        {
          "text": "LEETCODE 3 · MEDIUM",
          "at": [
            800,
            262
          ],
          "accent": true
        }
      ],
      "problem": {
        "statement": "Given a string *s*, find the length of the longest substring without duplicate characters.",
        "example": [
          "Input:  s = \"abcabcbb\"",
          "Output: 3",
          "The answer is \"abc\", with length 3"
        ],
        "constraints": [
          "0 <= s.length <= 5 * 10^4",
          "s consists of English letters, digits, symbols and spaces"
        ]
      }
    },
    {
      "eyebrow": "In plain English",
      "chapter": "Problem",
      "panel": false,
      "dur": 9,
      "caption": "What the interviewer is really asking.",
      "plain": {
        "asking": "Find the longest run of letters *where no letter appears twice*. Return how long it is.",
        "points": [
          "*You get:* a string, like \"abcabcbb\".",
          "*You return:* a length, like 3.",
          "*The catch:* the letters must sit next to each other."
        ]
      }
    },
    {
      "eyebrow": "The example",
      "dur": 7,
      "caption": "Here's the string, one letter per box. A *substring* is a run of neighbouring letters, with no gaps.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              800,
              440
            ],
            "scale": 0.9,
            "values": [
              "a",
              "b",
              "c",
              "a",
              "b",
              "c",
              "b",
              "b"
            ],
            "note": "Neighbouring letters only. You cannot skip one in the middle."
          }
        ]
      }
    },
    {
      "eyebrow": "The answer",
      "dur": 7,
      "caption": "The best run is *abc*, length 3. Stretch it to abca and the a repeats, so it breaks the rule.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              800,
              440
            ],
            "scale": 0.9,
            "values": [
              "a",
              "b",
              "c",
              "a",
              "b",
              "c",
              "b",
              "b"
            ],
            "hi": [
              0,
              1,
              2
            ]
          }
        ]
      },
      "labels": [
        {
          "text": "a b c → length 3",
          "at": [
            800,
            300
          ],
          "accent": true
        }
      ]
    },
    {
      "eyebrow": "The key idea",
      "chapter": "Solution",
      "dur": 9,
      "via": true,
      "caption": "Keep a *window*: a run with no repeats. Grow it on the right, one letter at a time. When a letter repeats, move the left edge past its old copy.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              800,
              440
            ],
            "scale": 0.9,
            "values": [
              "a",
              "b",
              "c",
              "a",
              "b",
              "c",
              "b",
              "b"
            ],
            "hi": [
              0,
              1,
              2
            ],
            "marks": [
              {
                "i": 0,
                "text": "left"
              },
              {
                "i": 2,
                "text": "right"
              }
            ]
          }
        ]
      },
      "labels": [
        {
          "text": "GROW ON THE RIGHT  ·  ON A REPEAT, JUMP THE LEFT",
          "at": [
            800,
            290
          ],
          "accent": true
        }
      ]
    },
    {
      "eyebrow": "The notebook",
      "dur": 8,
      "caption": "To jump fast, a *map* remembers where each letter was last seen. After a, b, c the window is abc, and the best is 3.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              560,
              440
            ],
            "scale": 0.75,
            "values": [
              "a",
              "b",
              "c",
              "a",
              "b",
              "c",
              "b",
              "b"
            ],
            "hi": [
              0,
              1,
              2
            ],
            "marks": [
              {
                "i": 0,
                "text": "left"
              },
              {
                "i": 2,
                "text": "right"
              }
            ]
          },
          {
            "shape": "map",
            "at": [
              1250,
              440
            ],
            "entries": [
              [
                "a",
                0
              ],
              [
                "b",
                1
              ],
              [
                "c",
                2
              ]
            ],
            "head": [
              "LETTER",
              "LAST SEEN"
            ],
            "hi": [],
            "note": "Where each letter was last seen. A repeat tells us exactly where the left edge must go."
          }
        ]
      },
      "labels": [
        {
          "text": "window: abc     best: 3",
          "at": [
            560,
            290
          ],
          "accent": false
        }
      ]
    },
    {
      "eyebrow": "Walk · a repeats",
      "dur": 8,
      "caption": "Next comes *a* again. The map says a was at 0, inside the window. So the left edge jumps to 1. The window is bca, still length 3.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              560,
              440
            ],
            "scale": 0.75,
            "values": [
              "a",
              "b",
              "c",
              "a",
              "b",
              "c",
              "b",
              "b"
            ],
            "hi": [
              1,
              2,
              3
            ],
            "dim": [
              0
            ],
            "marks": [
              {
                "i": 1,
                "text": "left"
              },
              {
                "i": 3,
                "text": "right"
              }
            ]
          },
          {
            "shape": "map",
            "at": [
              1250,
              440
            ],
            "entries": [
              [
                "a",
                3
              ],
              [
                "b",
                1
              ],
              [
                "c",
                2
              ]
            ],
            "head": [
              "LETTER",
              "LAST SEEN"
            ],
            "hi": [
              0
            ],
            "note": "Where each letter was last seen. A repeat tells us exactly where the left edge must go."
          }
        ]
      },
      "labels": [
        {
          "text": "a was at 0 → left = 1     window: bca     best: 3",
          "at": [
            560,
            290
          ],
          "accent": false
        }
      ]
    },
    {
      "eyebrow": "The window slides",
      "dur": 8,
      "caption": "Then b repeats, then c. Each time, left jumps one past the old copy. The window *slides* along, staying length 3.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              560,
              440
            ],
            "scale": 0.75,
            "values": [
              "a",
              "b",
              "c",
              "a",
              "b",
              "c",
              "b",
              "b"
            ],
            "hi": [
              3,
              4,
              5
            ],
            "dim": [
              0,
              1,
              2
            ],
            "marks": [
              {
                "i": 3,
                "text": "left"
              },
              {
                "i": 5,
                "text": "right"
              }
            ]
          },
          {
            "shape": "map",
            "at": [
              1250,
              440
            ],
            "entries": [
              [
                "a",
                3
              ],
              [
                "b",
                4
              ],
              [
                "c",
                5
              ]
            ],
            "head": [
              "LETTER",
              "LAST SEEN"
            ],
            "hi": [
              1,
              2
            ],
            "note": "Where each letter was last seen. A repeat tells us exactly where the left edge must go."
          }
        ]
      },
      "labels": [
        {
          "text": "window: abc     best: 3",
          "at": [
            560,
            290
          ],
          "accent": false
        }
      ]
    },
    {
      "eyebrow": "Two b’s in a row",
      "dur": 8,
      "caption": "b at 6: its old copy is at 4, so left jumps to 5. b again at 7: left jumps to 7. The window shrinks to *b*, and the best stays 3.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              560,
              440
            ],
            "scale": 0.75,
            "values": [
              "a",
              "b",
              "c",
              "a",
              "b",
              "c",
              "b",
              "b"
            ],
            "hi": [
              7
            ],
            "dim": [
              0,
              1,
              2,
              3,
              4,
              5,
              6
            ],
            "marks": [
              {
                "i": 7,
                "text": "left = right"
              }
            ]
          },
          {
            "shape": "map",
            "at": [
              1250,
              440
            ],
            "entries": [
              [
                "a",
                3
              ],
              [
                "b",
                7
              ],
              [
                "c",
                5
              ]
            ],
