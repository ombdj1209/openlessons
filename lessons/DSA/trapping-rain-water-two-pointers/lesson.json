      },
      "labels": [
        {
          "text": "def trap(height):",
          "at": [
            360,
            200
          ],
          "code": true
        },
        {
          "text": "    left, right = 0, len(height) - 1",
          "at": [
            360,
            234
          ],
          "code": true
        },
        {
          "text": "    best_left = best_right = water = 0",
          "at": [
            360,
            268
          ],
          "code": true
        },
        {
          "text": "    while left < right:",
          "at": [
            360,
            302
          ],
          "code": true
        },
        {
          "text": "        if height[left] < height[right]:     # left side is lower",
          "at": [
            360,
            336
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "            best_left = max(best_left, height[left])",
          "at": [
            360,
            370
          ],
          "code": true
        },
        {
          "text": "            water += best_left - height[left]",
          "at": [
            360,
            404
          ],
          "code": true
        },
        {
          "text": "            left += 1",
          "at": [
            360,
            438
          ],
          "code": true
        },
        {
          "text": "        else:                                # right side is lower",
          "at": [
            360,
            472
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "            best_right = max(best_right, height[right])",
          "at": [
            360,
            506
          ],
          "code": true
        },
        {
          "text": "            water += best_right - height[right]",
          "at": [
            360,
            540
          ],
          "code": true
        },
        {
          "text": "            right -= 1",
          "at": [
            360,
            574
          ],
          "code": true
        }
      ],
      "chapter": "Code"
    },
