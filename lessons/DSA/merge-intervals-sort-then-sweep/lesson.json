    },
    {
      "eyebrow": "Step 1 · sort by start",
      "chapter": "Solution",
      "dur": 9,
      "caption": "Sort by *start*. Now anything that overlaps the current range must come right after it, so one walk left to right is enough.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "intervals",
            "at": [
              760,
