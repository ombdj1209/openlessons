    },
    {
      "eyebrow": "Quick check",
      "caption": "Your turn.",
      "check": {
        "question": "Current is [1, 5]. The next range is [2, 4]. What is current now?",
        "options": [
          "[1, 4]",
          "[1, 5]",
          "[2, 5]"
        ],
        "answer": 1,
        "explain": "[2, 4] sits *inside* [1, 5]. Take the max of the two ends, not the new end, or the range would shrink. A classic bug."
      }
    },
    {
      "eyebrow": "The code",
      "chapter": "Code",
      "caption": "Here is the whole solution. The comments match the steps we just walked through.",
      "dur": 10,
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "box",
            "at": [
              800,
              420
            ],
            "w": 920,
            "h": 378
          }
        ]
      },
      "labels": [
        {
          "text": "def merge(intervals):",
          "at": [
            370,
            276
          ],
          "code": true
        },
        {
          "text": "    intervals.sort(key=lambda iv: iv[0])       # by start",
          "at": [
            370,
            312
          ],
          "code": true
        },
        {
          "text": "    out = [intervals[0]]",
          "at": [
            370,
            348
          ],
          "code": true
        },
        {
          "text": "    for start, end in intervals[1:]:",
          "at": [
            370,
            384
          ],
          "code": true
        },
        {
          "text": "        if start <= out[-1][1]:                # overlaps the last one",
          "at": [
            370,
            420
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "            out[-1][1] = max(out[-1][1], end)  # stretch it",
          "at": [
            370,
            456
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        else:",
          "at": [
            370,
            492
          ],
          "code": true
        },
        {
          "text": "            out.append([start, end])           # gap: a new range",
          "at": [
            370,
            528
          ],
          "code": true
        },
        {
          "text": "    return out",
          "at": [
            370,
            564
          ],
          "code": true
        }
      ]
    },
