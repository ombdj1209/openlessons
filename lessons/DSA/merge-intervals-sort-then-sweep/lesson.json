    {
      "eyebrow": "The answer",
      "dur": 8,
      "caption": "Three ranges are left: *[1, 6], [8, 10], [15, 18]*. The sort cost O(n log n); the walk itself was a single pass.",
      "form": {
        "type": "shapes",
        "items": [
