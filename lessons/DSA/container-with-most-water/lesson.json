    },
    {
      "eyebrow": "The answer",
      "dur": 8,
      "caption": "The best pair is 8 and 7, far apart: 7 high and 7 wide, *49*. Not the tallest pair, but the best balance of height and width.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "bars",
            "at": [
              800,
              430
            ],
            "values": [
              1,
              8,
              6,
