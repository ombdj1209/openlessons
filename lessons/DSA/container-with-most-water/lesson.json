            ],
            "hi": [
              0
            ],
            "marks": [
              {
                "i": 0,
                "text": "left"
              },
              {
                "i": 8,
                "text": "right"
              }
            ]
          }
        ]
      },
      "labels": [
        {
          "text": "1 is shorter than 7 → move left",
          "at": [
            800,
            210
          ],
          "accent": true
        }
      ]
    },
    {
      "eyebrow": "Walk",
      "dur": 8,
      "caption": "Left moves to 8. Now 8 and 7, 7 apart: *49*, the best so far. The right wall is shorter, so the right finger moves in.",
      "form": {
        "type": "shapes",
        "items": [
          {
