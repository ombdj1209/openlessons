      "labels": [
        {
          "text": "LEETCODE 11 · MEDIUM",
          "at": [
            800,
            262
          ],
          "accent": true
        }
      ],
      "problem": {
        "statement": "You are given an integer array *height* of length n. There are n vertical lines; the ends of line i are (i, 0) and (i, height[i]). Find two lines that, with the x-axis, form a container holding the most water. Return that amount. You may not slant the container.",
        "example": [
          "Input:  height = [1, 8, 6, 2, 5, 4, 8, 3, 7]",
          "Output: 49",
          "Lines 1 and 8 hold 7 × 7 = 49"
        ],
        "constraints": [
          "n == height.length",
          "2 <= n <= 10^5",
          "0 <= height[i] <= 10^4"
        ]
      }
    },
    {
      "eyebrow": "In plain English",
      "chapter": "Problem",
      "panel": false,
      "dur": 9,
      "caption": "What the interviewer is really asking.",
      "plain": {
        "asking": "Pick *two walls*. The water between them is as high as the shorter wall and as wide as the gap. Find the pair that holds the most.",
        "points": [
          "*You get:* wall heights, like [1, 8, 6, 2, 5, 4, 8, 3, 7].",
          "*You return:* the most water, like 49.",
          "*The catch:* n can be 100,000, so trying every pair is too slow."
        ]
      }
    },
    {
      "eyebrow": "The picture",
      "dur": 7,
      "caption": "Each number is a wall. Pick any two walls: water fills the space between them, up to the *shorter* one.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "bars",
            "at": [
              800,
              430
            ],
            "values": [
              1,
              8,
              6,
              2,
              5,
              4,
              8,
              3,
              7
            ],
            "note": "Wall heights. The index under each wall is its position."
          }
        ]
      }
    },
    {
      "eyebrow": "One pair",
      "dur": 8,
      "caption": "Take walls 8 and 5. Water rises only to 5, the shorter one, and it's 3 wide: *15*. The taller wall's extra height is wasted.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "bars",
            "at": [
              800,
              430
            ],
