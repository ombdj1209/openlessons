    {
      "eyebrow": "Quick check",
      "caption": "Your turn.",
      "check": {
        "question": "The left wall is 4, the right wall is 9, and they are 6 apart. Which finger moves?",
        "options": [
          "The left one, on the 4",
          "The right one, on the 9",
          "Both at once"
        ],
        "answer": 0,
        "explain": "The 4 caps the water. Moving the 9 only shrinks the width under the same cap of 4, so it can *never* do better."
      }
    },
    {
      "eyebrow": "The code",
      "chapter": "Code",
      "caption": "Here is the whole solution. Two fingers, one pass, O(n) time and no extra memory.",
      "dur": 10,
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "box",
            "at": [
              800,
              420
            ],
            "w": 920,
            "h": 378
          }
        ]
      },
      "labels": [
        {
          "text": "def max_area(height):",
          "at": [
            370,
            276
          ],
          "code": true
        },
        {
          "text": "    l, r, best = 0, len(height) - 1, 0",
          "at": [
            370,
            312
          ],
          "code": true
        },
        {
          "text": "    while l < r:",
          "at": [
            370,
            348
          ],
          "code": true
        },
        {
          "text": "        best = max(best, min(height[l], height[r]) * (r - l))",
          "at": [
            370,
            384
          ],
          "code": true
        },
        {
          "text": "        if height[l] < height[r]:",
          "at": [
            370,
            420
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "            l += 1          # the shorter wall is the cap: drop it",
          "at": [
            370,
            456
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        else:",
          "at": [
            370,
            492
          ],
          "code": true
        },
        {
          "text": "            r -= 1",
          "at": [
            370,
            528
          ],
          "code": true
        },
        {
          "text": "    return best",
          "at": [
            370,
            564
          ],
          "code": true
        }
      ]
    },
