    },
    {
      "eyebrow": "Not rain water",
      "dur": 8,
      "caption": "Careful: this isn't Trapping Rain Water. There, every dip holds water. Here you pick *one pair*, and the walls between are ignored."
    },
    {
      "eyebrow": "The key idea",
      "chapter": "Solution",
      "dur": 9,
      "caption": "Start with a finger on each end: the widest container. Every move makes it narrower, so a move only helps if the water gets *taller*.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "bars",
            "at": [
              800,
              430
            ],
            "values": [
              1,
              8,
              6,
              2,
              5,
              4,
              8,
              3,
              7
            ],
            "span": [
              0,
              8
            ],
            "marks": [
              {
                "i": 0,
                "text": "left"
              },
              {
                "i": 8,
                "text": "right"
              }
            ]
          }
        ]
      },
      "labels": [
        {
          "text": "area = min(1, 7) × 8 = 8     best: 8",
          "at": [
            800,
            210
          ]
        }
      ]
    },
    {
      "eyebrow": "Move the shorter wall",
      "dur": 10,
      "caption": "The shorter wall caps the water. Moving the taller finger can't lift that cap, it only loses width. So always move the *shorter* one.",
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "bars",
            "at": [
              800,
              430
            ],
            "values": [
              1,
