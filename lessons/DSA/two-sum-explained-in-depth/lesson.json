      "labels": [
        {
          "text": "def two_sum(nums, target):",
          "at": [
            430,
            316
          ],
          "code": true
        },
        {
          "text": "    notebook = {}                  # number -> position",
          "at": [
            430,
            352
          ],
          "code": true
        },
        {
          "text": "    for i, x in enumerate(nums):   # walk once",
          "at": [
            430,
            388
          ],
          "code": true
        },
        {
          "text": "        partner = target - x",
          "at": [
            430,
            424
          ],
          "code": true
        },
        {
          "text": "        if partner in notebook:    # seen it before?",
          "at": [
            430,
            460
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "            return [notebook[partner], i]",
          "at": [
            430,
            496
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        notebook[x] = i            # write it down",
          "at": [
            430,
            532
          ],
          "code": true
        }
      ],
      "chapter": "Code"
