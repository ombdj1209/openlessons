      "labels": [
        {
          "text": "LEETCODE 1 · EASY",
          "at": [
            800,
            262
          ],
          "accent": true
        }
      ],
      "problem": {
        "statement": "Given an array of integers *nums* and an integer *target*, return the indices of the two numbers that add up to target. Each input has exactly one solution, and you may not use the same element twice.",
        "example": [
          "Input:  nums = [2, 7, 11, 15], target = 9",
          "Output: [0, 1]",
          "Because nums[0] + nums[1] = 2 + 7 = 9"
        ],
        "constraints": [
          "2 <= nums.length <= 10^4",
          "-10^9 <= nums[i], target <= 10^9",
          "Only one valid answer exists"
        ],
        "followUp": "Can you do it in less than O(n²) time?"
      }
    },
    {
      "eyebrow": "In plain English",
      "chapter": "Problem",
      "panel": false,
      "dur": 9,
      "caption": "What the interviewer is really asking.",
      "plain": {
        "asking": "You get a list of numbers and a target. Find the *two numbers that add up to the target*, and say where they are in the list.",
        "points": [
          "*You get:* a list of numbers, and one target number.",
          "*You return:* the two positions, like [0, 1].",
          "*The catch:* checking every pair is too slow. Find something faster."
        ]
      }
    },
    {
      "eyebrow": "The example",
      "caption": "Let's use a slightly longer list, so there's more to walk through. Two of these numbers add up to *9*. Can you spot them?",
      "dur": 7,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
              800,
              430
