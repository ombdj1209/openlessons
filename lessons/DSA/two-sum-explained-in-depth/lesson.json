    {
      "eyebrow": "What the follow-up means",
      "caption": "O(n²) means checking every pair. The follow-up wants better: ideally *O(n)*, which simply means looking at each number once.",
      "dur": 7.5,
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "text",
            "at": [
