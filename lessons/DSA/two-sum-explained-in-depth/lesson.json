        ]
      }
    },
    {
      "eyebrow": "The key idea",
      "caption": "When you stand on a number, you already know its partner. Standing on 7, the partner *must* be 9 − 7 = 2.",
      "dur": 7.5,
      "via": true,
      "form": {
        "type": "shapes",
        "items": [
          {
            "shape": "array",
            "at": [
