      "problem": {
        "statement": "Given *head*, the head of a linked list, determine if the linked list has a cycle in it. There is a cycle if some node can be reached again by continuously following the next pointer.",
        "example": [
          "Input:  head = [3, 2, 0, -4], last node points back to index 1",
          "Output: true"
        ],
        "constraints": [
          "0 <= number of nodes <= 10^4",
          "-10^5 <= Node.val <= 10^5"
        ],
        "followUp": "Can you solve it using O(1), constant, memory?"
      }
    },
