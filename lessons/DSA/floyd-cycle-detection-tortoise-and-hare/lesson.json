      "plain": {
        "asking": "You can only follow arrows from one item to the next. *Does following the arrows ever loop back*, or does the list end?",
        "points": [
          "*You get:* the first item of the list.",
          "*You return:* true if it loops, false if it ends.",
          "*The catch:* you can't keep a record of every item you visit."
        ]
