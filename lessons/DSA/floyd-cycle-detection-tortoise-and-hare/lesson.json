      "labels": [
        {
          "text": "def has_cycle(start):",
          "at": [
            430,
            304
          ],
          "code": true
        },
        {
          "text": "    slow = fast = start",
          "at": [
            430,
            340
          ],
          "code": true
        },
        {
          "text": "    while fast and fast.next:",
          "at": [
            430,
            376
          ],
          "code": true
        },
        {
          "text": "        slow = slow.next          # 1 step",
          "at": [
            430,
            412
          ],
          "code": true
        },
        {
          "text": "        fast = fast.next.next     # 2 steps",
          "at": [
            430,
            448
          ],
          "code": true
        },
        {
          "text": "        if slow is fast:          # caught up",
          "at": [
            430,
            484
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "            return True",
          "at": [
            430,
            520
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "    return False                  # fast hit the end",
          "at": [
            430,
            556
          ],
          "code": true
        }
      ],
      "chapter": "Code"
    },
