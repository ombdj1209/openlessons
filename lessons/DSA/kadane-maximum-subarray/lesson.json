      "labels": [
        {
          "text": "def max_subarray(nums):",
          "at": [
            410,
            330
          ],
          "code": true
        },
        {
          "text": "    total = best = nums[0]",
          "at": [
            410,
            366
          ],
          "code": true
        },
        {
          "text": "    for x in nums[1:]:",
          "at": [
            410,
            402
          ],
          "code": true
        },
        {
          "text": "        total = max(x, total + x)    # start fresh, or keep going",
          "at": [
            410,
            438
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        best = max(best, total)      # remember the best so far",
          "at": [
            410,
            474
          ],
          "code": true
        },
        {
