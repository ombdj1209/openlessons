      "problem": {
        "statement": "Given an integer array *nums*, find the subarray with the largest sum, and return its sum. A subarray is a run of neighbouring elements.",
        "example": [
          "Input:  nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]",
          "Output: 6",
          "The subarray [4, -1, 2, 1] has the largest sum"
        ],
        "constraints": [
          "1 <= nums.length <= 10^5",
          "-10^4 <= nums[i] <= 10^4"
        ],
        "followUp": "Can you do it in a single pass, in O(n) time?"
      }
    },
    {
      "eyebrow": "In plain English",
      "chapter": "Problem",
      "panel": false,
      "dur": 9,
      "caption": "What the interviewer is really asking.",
      "plain": {
        "asking": "Pick a stretch of numbers that sit next to each other. *Which stretch adds up to the most?*",
        "points": [
          "*You get:* a list of numbers, some of them negative.",
          "*You return:* the biggest possible sum, like 6.",
          "*The catch:* walk through the list only once."
        ]
      }
    },
