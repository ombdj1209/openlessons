      "labels": [
        {
          "text": "def find(nums, target):",
          "at": [
            390,
            224
          ],
          "code": true
        },
        {
          "text": "    start, end = 0, len(nums) - 1",
          "at": [
            390,
            258
          ],
          "code": true
        },
        {
          "text": "    while start <= end:",
          "at": [
            390,
            292
          ],
          "code": true
        },
        {
          "text": "        middle = (start + end) // 2",
          "at": [
            390,
            326
          ],
          "code": true,
          "accent": true
        },
        {
          "text": "        if nums[middle] == target:",
          "at": [
            390,
            360
          ],
          "code": true
        },
        {
          "text": "            return middle              # found it",
          "at": [
            390,
            394
          ],
          "code": true
        },
        {
          "text": "        if nums[middle] < target:",
          "at": [
            390,
            428
          ],
          "code": true
        },
        {
          "text": "            start = middle + 1         # rule out the left half",
          "at": [
            390,
            462
          ],
          "code": true
        },
        {
          "text": "        else:",
          "at": [
            390,
            496
          ],
          "code": true
        },
        {
          "text": "            end = middle - 1           # rule out the right half",
          "at": [
            390,
            530
          ],
          "code": true
        },
        {
          "text": "    return -1                          # not in the list",
          "at": [
            390,
            564
          ],
          "code": true
        }
      ],
      "chapter": "Code"
    },
